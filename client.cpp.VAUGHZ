void client:: pipeWritting(char* buf){//в лупе добавить
    int b = pipec->open(fd,QIODeviceBase::WriteOnly);
    if(!b){
        qDebug()<<"pipe writting error";
        return;
    }
    pipec->write(buf,sizeof(buf));
}
